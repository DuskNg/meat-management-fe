{
  "expo": {
    "name": "Quản lý hệ thống",
    "slug": "quan-ly-he-thong",
    "scheme": "quanlyhethong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép chụp tích kê để nhận diện mặt hàng.",
        "NSMicrophoneUsageDescription": "Cho phép ghi âm câu nói để tạo giao dịch nhanh."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép chụp tích kê để nhận diện mặt hàng."
        }
      ]
    ]
  }
}
